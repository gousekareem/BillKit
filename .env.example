# BillKit environment configuration — copy to `.env` in the repository root and edit.
# NEVER commit the real .env. Every value below is a placeholder or a safe default.
# © 2026 Shaik Gouse Kareem. All rights reserved.

# --- Runtime ---
APP_ENV=development              # development | test | production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173   # origin the browser uses (production: https://your-domain)
ADDITIONAL_ORIGINS=                  # optional comma-separated extra allowed origins
DATA_DIR=                            # default: backend/data — SQLite database + uploaded images (back this up)
STATIC_DIR=                          # production: absolute path to website/dist to serve the site from the API process
COOKIE_SECURE=                       # defaults to true when APP_ENV=production (requires HTTPS)
TRUST_PROXY=false                    # true when behind a reverse proxy that sets X-Forwarded-*
SESSION_DAYS=30
REGISTRATION_OPEN=true
PROCESSING_CONCURRENCY=1             # parallel OCR jobs (1–4); each uses one CPU core
UNSAVED_SCAN_RETENTION_HOURS=24      # unsaved scans and their images are deleted after this
RATE_LIMIT_SCALE=1                   # multiply all rate limits (tests use 20)

# --- OCR (Tesseract via tesseract.js; English model bundled via npm) ---
OCR_LANGS=eng                        # e.g. eng+hin — requires OCR_LANG_PATH with those .traineddata files
OCR_LANG_PATH=
OCR_WORKERS=1
OCR_PSM=                             # page segmentation mode override (default 4)

# --- Optional vision-language model (off unless both lines are set) ---
AI_PROVIDER=none                     # none | anthropic
AI_PROVIDER_API_KEY=YOUR_API_KEY     # server-side only; never sent to the browser
AI_MODEL=claude-sonnet-5-5           # check the current model list at https://docs.claude.com
AI_VLM_MODE=ambiguous_only           # ambiguous_only | always
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_PRICE_INPUT_PER_MTOK=             # USD per million input tokens (for cost estimates; blank = no estimate)
AI_PRICE_OUTPUT_PER_MTOK=

# --- Optional email (password reset + contact forwarding) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=CHANGE_ME
SMTP_FROM=                           # e.g. "BillKit <no-reply@your-domain>"
CONTACT_TO_EMAIL=                    # where contact-form messages are forwarded

# --- Website build ---
SITE_URL=https://YOUR_DOMAIN         # used for canonical URLs, Open Graph and sitemap.xml
BILLKIT_API_URL=http://127.0.0.1:8787  # Vite dev/preview proxy target
