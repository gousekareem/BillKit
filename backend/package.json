{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "admin:grant": "tsx --env-file-if-exists=../.env src/cli/grant-admin.ts",
    "corrections:export": "tsx --env-file-if-exists=../.env src/cli/export-corrections.ts"
  },
  "dependencies": {
    "@billkit/ai": "1.0.0",
    "@billkit/shared": "1.0.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2"
  }
}
